{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "build-debug",   "configurePreset": "dev-debug"   },
    { "name": "build-release", "configurePreset": "dev-release" }
  ],
  "testPresets": [
    { "name": "test-debug", "configurePreset": "dev-debug", "output": { "outputOnFailure": true } }
  ]
}
